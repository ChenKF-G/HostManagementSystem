# 环境变量示例

# Django 基础
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=*

# MySQL 数据库
DB_NAME=host_manager
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis（Celery Broker / Backend）
REDIS_URL=redis://127.0.0.1:6379/0

# 密码加密密钥
